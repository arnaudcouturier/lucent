{
  "basedOnContent": "2026.10.16",
  "id": "2026.10.17",
  "channel": "beta",
  "minAppVersion": "0.3.0-beta.2",
  "changelog": [
    "Updated OptiScaler winmm.dll: fixes the FPS counter overlay and other overlay bugs.",
    "Everything else is unchanged from 2026.10.16."
  ],
  "configUpdateRules": [
    {
      "path": "OptiScaler.ini",
      "update": "addMissingKeys",
      "rationale": "Only keys absent from an existing OptiScaler.ini are added, so a tuned config keeps its values. Reset setup… writes the tested baseline with the new Neural Rendering choices."
    },
    {
      "path": "ReShade.ini",
      "when": "reshade",
      "update": "keep",
      "rationale": "No ReShade layout change; keep the player's active preset, keybinds and overlay choices."
    },
    {
      "path": "ReshadeEffectShaderToggler.ini",
      "when": "reshade",
      "update": "keep",
      "rationale": "No Shader Toggler layout change; keep the player's effect groups and keybinds."
    }
  ],
  "neuralRenderingControls": {
    "presetKey": {
      "file": "OptiScaler.ini",
      "section": "QualityOverrides",
      "key": "ForcePerfQuality"
    },
    "presets": [
      {
        "id": "dlaa",
        "label": "DLAA",
        "ratio": 1,
        "value": "5"
      },
      {
        "id": "ultra-quality",
        "label": "Ultra Quality",
        "ratio": 1.3,
        "value": "4"
      },
      {
        "id": "quality",
        "label": "Quality",
        "ratio": 1.5,
        "value": "2"
      },
      {
        "id": "balanced",
        "label": "Balanced",
        "ratio": 1.7,
        "value": "1"
      },
      {
        "id": "performance",
        "label": "Performance",
        "ratio": 2,
        "value": "0"
      },
      {
        "id": "ultra-performance",
        "label": "Ultra Performance",
        "ratio": 3,
        "value": "3"
      }
    ],
    "passesKey": {
      "file": "OptiScaler.ini",
      "section": "DlssNr",
      "key": "Passes"
    },
    "scaleKey": {
      "file": "OptiScaler.ini",
      "section": "DlssNr",
      "key": "WorkingScale"
    },
    "spatialCompression": {
      "key": {
        "file": "OptiScaler.ini",
        "section": "DlssNr",
        "key": "SpatialCompression"
      },
      "label": "Spatial compression",
      "description": "Saves performance by giving the edges of the screen less Neural Rendering detail. The centre is untouched."
    },
    "residualFg": {
      "key": {
        "file": "OptiScaler.ini",
        "section": "DlssNr",
        "key": "ResidualFG"
      },
      "label": "Residual frame generation",
      "description": "Runs Neural Rendering on every second frame and lets NVIDIA frame generation fill the rest. Faster, but the image arrives one frame late, so motion blur and the HUD can look slightly off.",
      "experimental": true,
      "gpuNamePatterns": [
        "RTX\\s?40[0-9]{2}",
        "RTX\\s?50[0-9]{2}"
      ]
    },
    "defaults": [
      {
        "gpuNamePatterns": [
          "RTX\\s?4090",
          "RTX\\s?4080",
          "RTX\\s?5090",
          "RTX\\s?5080"
        ],
        "preset": "quality",
        "passes": 2
      },
      {
        "gpuNamePatterns": [
          "RTX\\s?4070\\s?Ti",
          "RTX\\s?5070\\s?Ti",
          "RTX\\s?3090",
          "RTX\\s?3080\\s?Ti"
        ],
        "preset": "quality",
        "passes": 1
      },
      {
        "preset": "balanced",
        "passes": 1
      }
    ]
  },
  "mfgUnlock": {
    "gpuNamePatterns": [
      "RTX\\s?40[0-9]{2}"
    ],
    "label": "Unlock multi-frame generation",
    "description": "Adds 3× to 6× and Dynamic on RTX 40, which NVIDIA doesn’t officially support. It also works with 2×.",
    "gates": [
      "3x",
      "4x",
      "5x",
      "6x",
      "dynamic"
    ],
    "settings": [
      {
        "file": "OptiScaler.ini",
        "section": "DLSSG",
        "key": "AdaMfgUnlock",
        "value": "true"
      }
    ]
  },
  "replaceFiles": [
    {
